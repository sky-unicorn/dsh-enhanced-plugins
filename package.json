{
  "name": "dsh-enhanced-plugins",
  "version": "0.1.0",
  "description": "Aggregate and selective DeepSeek Harness enhancements, including a standalone Windows launcher companion",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./edit-last-message/host": "./lib/edit-last-message/host/index.js",
    "./agent-team-monitor": "./lib/agent-team-monitor/host/index.js",
    "./mcp-server-manager": "./lib/mcp-server-manager/host/index.js",
    "./notification": "./lib/notification/host/index.js",
    "./plugin-market": "./lib/plugin-market/index.js",
    "./sub-agent/host": "./lib/sub-agent/host.js",
    "./sub-agent/preset": "./lib/sub-agent/preset.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dshEnhanced": {
    "manager": {
      "protocolVersion": 1,
      "catalogVersion": 1,
      "repository": "sky-unicorn/dsh-enhanced-plugins",
      "defaultRef": "master"
    },
    "retiredFeatures": [
      {
        "feature": "referenced-file",
        "packageNames": [
          "dsh-enhanced-referenced-file",
          "dsh-referenced-file"
        ],
        "notice": "Official DSH now supports @ workspace file references; update DSH to the latest release."
      }
    ]
  },
  "files": [
    "lib/",
    "assets/plugins-cache.json",
    "assets/notification/",
    "assets/readme/desktop-notifications.png",
    "assets/readme/edit-last-message.png",
    "assets/readme/agent-team-monitor.png",
    "assets/readme/mcp-server-manager.png",
    "assets/readme/model-input-types.png",
    "assets/readme/plugin-community.png",
    "assets/readme/subagent-toggles.png",
    "assets/readme/windows-launcher.png",
    "packages/windows-launcher/lib/",
    "packages/windows-launcher/package.json",
    "scripts/migrate-to-enhanced-plugin.ps1",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.client.json --noEmit",
    "test:edit-last-message": "vitest run --config vitest.edit-last-message.config.ts",
    "test:mcp": "vitest run --config vitest.mcp.config.ts",
    "test:model-input-types": "vitest run --config vitest.model-input-types.config.ts",
    "test:notification": "vitest run --config vitest.notification.config.ts",
    "test:market": "vitest run --config vitest.market.config.ts",
    "test:sub-agent": "vitest run --config vitest.sub-agent.config.ts",
    "test:agent-team-monitor": "vitest run --config vitest.agent-team-monitor.config.ts",
    "test:packages": "vitest run --config vitest.packages.config.ts",
    "test": "npm run test:edit-last-message && npm run test:mcp && npm run test:model-input-types && npm run test:notification && npm run test:market && npm run test:sub-agent && npm run test:agent-team-monitor && npm run test:packages",
    "check": "npm run typecheck && npm test && npm run build",
    "market:index": "node scripts/update-plugin-index.mjs",
    "pack:dry-run": "node scripts/pack-dry-run.mjs",
    "verify:launcher": "node scripts/verify-windows-launcher.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "subagent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sky-unicorn/dsh-enhanced-plugins.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "smol-toml": "^1.7.1",
    "undici": "^7.29.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-attachment": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-subagent-claude-code": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-subagent-codex": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-tool-subagent": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
