{
  "name": "dsh-enhanced-edit-last-message",
  "version": "0.1.0",
  "description": "Selective DSH bundle for editing and resending the latest user message",
  "type": "module",
  "main": "./lib/edit-last-message/host/index.js",
  "exports": {
    ".": "./lib/edit-last-message/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dshEnhanced": { "feature": "edit-last-message", "legacyPackages": [] },
  "files": ["lib/", "cordis.patch.yml"],
  "scripts": { "build": "node ../../build.mjs --feature edit-last-message", "prepare": "npm run build" },
  "license": "MIT",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-attachment": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.5 <0.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
