{
  "name": "dsh-enhanced-windows-launcher",
  "version": "3.1.1",
  "description": "Standalone Windows tray launcher and control center for DeepSeek Harness",
  "type": "module",
  "dshEnhanced": {
    "feature": "windows-launcher",
    "kind": "companion",
    "platforms": [
      "win32"
    ],
    "legacyPackages": [],
    "manager": {
      "scope": "global",
      "required": true,
      "defaultSelected": true,
      "order": 0,
      "category": "system",
      "name": {
        "zh-CN": "Windows Launcher",
        "en-US": "Windows Launcher"
      },
      "description": {
        "zh-CN": "本机 DSH 控制中心与本项目插件管理器。",
        "en-US": "Local DSH control center and project plugin manager."
      }
    },
    "runtimeEntries": [
      "./lib/DSH-Launcher.exe",
      "./lib/DSH-Launcher.exe.config",
      "./lib/DSH-Launcher.Supervisor.ps1",
      "./lib/DSH-Launcher.Command.ps1",
      "./lib/DSH-Launcher.PluginManager.ps1"
    ]
  },
  "files": [
    "lib/",
    "src/",
    "tools/",
    "build.mjs"
  ],
  "scripts": {
    "build": "node ./build.mjs",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
