{
  "name": "dsh-enhanced-model-input-types",
  "version": "0.1.0",
  "description": "Selective DSH bundle for pi-ai model request-type settings",
  "type": "module",
  "main": "./lib/model-input-types/host/index.js",
  "exports": {
    ".": "./lib/model-input-types/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dshEnhanced": {
    "feature": "model-input-types",
    "kind": "bundle",
    "legacyPackages": [],
    "manager": {
      "scope": "profile",
      "required": false,
      "defaultSelected": true,
      "order": 30,
      "category": "model",
      "name": { "zh-CN": "模型输入类型", "en-US": "Model Input Types" },
      "description": {
        "zh-CN": "配置模型请求支持的输入类型。",
        "en-US": "Configure the input types supported by model requests."
      }
    }
  },
  "files": ["lib/", "cordis.patch.yml"],
  "scripts": { "build": "node ../../build.mjs --feature model-input-types", "prepare": "npm run build" },
  "license": "MIT",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <0.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
