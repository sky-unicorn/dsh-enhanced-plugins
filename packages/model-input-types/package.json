{
  "name": "dsh-enhanced-model-input-types",
  "version": "2.5.1",
  "description": "Selective DSH bundle for pi-ai model request-type settings",
  "type": "module",
  "main": "./lib/model-input-types/host/index.js",
  "exports": {
    ".": "./lib/model-input-types/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dshEnhanced": {
    "feature": "model-input-types",
    "kind": "bundle",
    "legacyPackages": [],
    "manager": {
      "scope": "profile",
      "required": false,
      "defaultSelected": true,
      "order": 30,
      "category": "model",
      "name": {
        "zh-CN": "模型输入类型",
        "en-US": "Model Input Types"
      },
      "description": {
        "zh-CN": "配置模型请求支持的输入类型。",
        "en-US": "Configure the input types supported by model requests."
      }
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "src/",
    "build.mjs",
    "build-client.mjs",
    "build-support.mjs",
    "build-config.json"
  ],
  "scripts": {
    "build": "node ./build.mjs --feature model-input-types",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
