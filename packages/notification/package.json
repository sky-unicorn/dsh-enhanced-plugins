{
  "name": "dsh-enhanced-notification",
  "version": "2.5.0",
  "description": "Selective DSH bundle for desktop notifications and the DeepSeek pet",
  "type": "module",
  "main": "./lib/notification/host/index.js",
  "exports": {
    ".": "./lib/notification/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dshEnhanced": {
    "feature": "notification",
    "kind": "bundle",
    "legacyPackages": [],
    "manager": {
      "scope": "profile",
      "required": false,
      "defaultSelected": true,
      "order": 40,
      "category": "experience",
      "name": {
        "zh-CN": "桌面通知",
        "en-US": "Desktop Notifications"
      },
      "description": {
        "zh-CN": "提供桌面通知、提示音与桌面宠物联动。",
        "en-US": "Desktop notifications, sounds, and desktop-pet integration."
      }
    }
  },
  "files": [
    "lib/",
    "assets/notification/",
    "cordis.patch.yml",
    "src/",
    "build.mjs",
    "build-client.mjs",
    "build-support.mjs",
    "build-config.json"
  ],
  "scripts": {
    "build": "node ./build.mjs --feature notification",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.5",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
