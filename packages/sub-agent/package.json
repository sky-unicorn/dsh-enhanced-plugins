{
  "name": "dsh-enhanced-sub-agent",
  "version": "0.3.0",
  "description": "Selective DSH bundle for Claude Code and Codex product-subagent toggles",
  "type": "module",
  "main": "./lib/sub-agent/host.js",
  "exports": {
    ".": "./lib/sub-agent/host.js",
    "./client": "./lib/client.js",
    "./preset": "./lib/sub-agent/preset.js",
    "./codex": "./lib/sub-agent/codex.js",
    "./claude-code": "./lib/sub-agent/claude-code.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dshEnhanced": {
    "feature": "sub-agent",
    "kind": "bundle",
    "legacyPackages": [
      "dsh-sub-agent-toggle"
    ],
    "manager": {
      "scope": "profile",
      "required": false,
      "defaultSelected": true,
      "order": 60,
      "category": "agent",
      "name": {
        "zh-CN": "产品 Sub-Agent",
        "en-US": "Product Subagents"
      },
      "description": {
        "zh-CN": "按需启用 Claude Code 与 Codex 子代理工具。",
        "en-US": "Enable Claude Code and Codex subagent tools on demand."
      }
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "src/",
    "build.mjs",
    "build-client.mjs",
    "build-support.mjs",
    "build-config.json"
  ],
  "scripts": {
    "build": "node ./build.mjs --feature sub-agent",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-subagent-claude-code": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-subagent-codex": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tool-subagent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.2",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
