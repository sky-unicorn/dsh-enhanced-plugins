{
  "name": "dsh-enhanced-agent-team-monitor",
  "version": "0.1.0",
  "description": "Per-conversation Web monitor for DSH Agent Teams and workflow members",
  "type": "module",
  "main": "./lib/agent-team-monitor/host/index.js",
  "exports": {
    ".": "./lib/agent-team-monitor/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dshEnhanced": {
    "feature": "agent-team-monitor",
    "kind": "bundle",
    "legacyPackages": [],
    "build": {
      "script": "./build.mjs",
      "hostEntries": ["src/agent-team-monitor/shared.ts", "src/agent-team-monitor/host/index.ts", "src/agent-team-monitor/host/snapshot.ts", "src/agent-team-monitor/host/workflow.ts", "src/agent-team-monitor/host/catalog.ts"]
    },
    "manager": {
      "scope": "profile", "required": false, "defaultSelected": true, "order": 65, "category": "conversation",
      "name": { "zh-CN": "官方团队监控", "en-US": "Official Team Monitor" },
      "description": { "zh-CN": "按会话查看 DSH 工作流成员与官方 Agent Teams 任务、依赖和历史。", "en-US": "Inspect per-conversation workflow members and official Agent Teams tasks, dependencies and history." }
    }
  },
  "files": ["lib/", "src/", "build.mjs", "cordis.patch.yml", "README.md"],
  "scripts": { "build": "node ./build.mjs --feature agent-team-monitor", "prepare": "npm run build" },
  "license": "MIT",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "dependencies": { "clsx": "^2.1.1" },
  "devDependencies": { "esbuild": "^0.25.0" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-subagent": { "optional": true } },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2 <0.2.0",
    "react": "^18.2.0"
  }
}
