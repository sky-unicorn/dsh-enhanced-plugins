{
  "name": "dsh-enhanced-mcp-server-manager",
  "version": "0.3.0",
  "description": "Selective DSH bundle for MCP server management",
  "type": "module",
  "main": "./lib/mcp-server-manager/host/index.js",
  "exports": {
    ".": "./lib/mcp-server-manager/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dshEnhanced": {
    "feature": "mcp-server-manager",
    "kind": "bundle",
    "legacyPackages": [
      "dsh-mcp-server-manager"
    ],
    "manager": {
      "scope": "profile",
      "required": false,
      "defaultSelected": true,
      "order": 20,
      "category": "integration",
      "name": {
        "zh-CN": "MCP 服务管理",
        "en-US": "MCP Server Manager"
      },
      "description": {
        "zh-CN": "管理 MCP 服务并导入本机已有配置。",
        "en-US": "Manage MCP servers and import existing local configuration."
      }
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "src/",
    "build.mjs",
    "build-client.mjs",
    "build-support.mjs",
    "build-config.json"
  ],
  "scripts": {
    "build": "node ./build.mjs --feature mcp-server-manager",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "smol-toml": "^1.7.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.2",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
